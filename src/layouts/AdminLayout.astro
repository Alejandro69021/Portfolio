---
export const prerender = false;

import '../styles/global.css';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'projects' | 'jobs' | 'events' | 'pages' | 'media' | 'settings';
}

const { title = "Dashboard Admin — Walex Portfolio", activeNav = "dashboard" } = Astro.props;

const navItems = [
  {
    id: 'dashboard', label: 'Dashboard', href: '/admin',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>`,
  },
  {
    id: 'projects', label: 'Karya', href: '/admin/projects',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  },
  {
    id: 'jobs', label: 'Pengalaman', href: '/admin/jobs',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>`,
  },
  {
    id: 'events', label: 'Galeri', href: '/admin/events',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="3" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21"/><line x1="3" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21" y2="12"/></svg>`,
  },
  {
    id: 'pages', label: 'Halaman', href: '/admin/pages',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    id: 'media', label: 'Media', href: '/admin/media',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
  },
  {
    id: 'settings', label: 'Pengaturan', href: '/admin/settings',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
  },
];
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="robots" content="noindex, nofollow" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="bg-[#FBFBF9] text-[#1C1917] antialiased font-sans min-h-screen flex flex-col md:flex-row">
    
    <!-- MOBILE TOPBAR -->
    <header class="md:hidden bg-white border-b border-[#E7E5E4] px-4 py-3 flex items-center justify-between sticky top-0 z-50">
      <a href="/admin" class="font-serif text-xl font-bold tracking-tight text-[#1C1917]">
        walex<span class="text-[#EA580C]">.</span> <span class="text-xs font-mono text-[#78716C] uppercase font-normal">Admin</span>
      </a>
      <button id="mobile-menu-btn" class="p-2 border border-[#E7E5E4] rounded text-[#1C1917] hover:border-[#EA580C] focus:outline-none" aria-label="Buka Menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </header>

    <!-- BACKDROP FOR MOBILE SIDEBAR -->
    <div id="sidebar-backdrop" class="fixed inset-0 bg-black/40 z-40 hidden md:hidden transition-opacity"></div>

    <!-- SIDEBAR -->
    <aside id="admin-sidebar" class="fixed md:sticky top-0 left-0 h-screen w-64 bg-white border-r border-[#E7E5E4] flex flex-col justify-between p-6 z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out">
      
      <!-- Brand & Navigation -->
      <div class="space-y-8">
        <div class="flex items-center justify-between">
          <a href="/admin" class="font-serif text-2xl font-bold tracking-tight text-[#1C1917] hover:text-[#EA580C] transition-colors">
            walex<span class="text-[#EA580C]">.</span>
            <span class="block text-[10px] font-mono font-normal uppercase text-[#78716C] tracking-widest mt-0.5">CMS Studio v2</span>
          </a>
          <button id="sidebar-close-btn" class="md:hidden text-[#78716C] hover:text-[#1C1917]" aria-label="Tutup Menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>

        <nav class="space-y-1 font-mono text-xs">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-3 py-2.5 transition-colors duration-200 ${
                activeNav === item.id
                  ? 'bg-[#1C1917] text-[#FBFBF9] font-bold'
                  : 'text-[#78716C] hover:bg-[#1C1917] hover:text-[#FBFBF9]'
              }`}
            >
              <span class="shrink-0" set:html={item.icon} />
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <!-- Bottom Actions -->
      <div class="space-y-3 pt-6 border-t border-[#E7E5E4] font-mono text-xs">
        <a
          href="/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-between px-3 py-2 text-[#78716C] hover:text-[#EA580C] hover:bg-[#E7E5E4]/30 transition-colors"
        >
          <span>↗ Lihat Web Publik</span>
        </a>

        <form action="/api/auth/logout" method="POST">
          <button
            type="submit"
            class="w-full flex items-center gap-2 px-3 py-2 text-[#78716C] hover:bg-[#1C1917] hover:text-[#FBFBF9] transition-colors duration-200 text-left"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Keluar</span>
          </button>
        </form>
      </div>

    </aside>

    <!-- MAIN CONTENT AREA -->
    <main class="flex-1 min-w-0 p-6 md:p-10 max-w-7xl mx-auto w-full">
      <slot />
    </main>

    <script>
      const menuBtn = document.getElementById('mobile-menu-btn');
      const closeBtn = document.getElementById('sidebar-close-btn');
      const sidebar = document.getElementById('admin-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');

      function toggleSidebar(open: boolean) {
        if (!sidebar || !backdrop) return;
        if (open) {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('hidden');
        } else {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }
      }

      menuBtn?.addEventListener('click', () => toggleSidebar(true));
      closeBtn?.addEventListener('click', () => toggleSidebar(false));
      backdrop?.addEventListener('click', () => toggleSidebar(false));
    </script>
  </body>
</html>
