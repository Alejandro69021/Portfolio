---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getPublicSupabase, createSupabaseServerClient } from '../../lib/supabase/server';
import { renderAndSanitizeMarkdown } from '../../lib/markdown';
import { getVideoEmbedUrl } from '../../lib/validation';

const { slug } = Astro.params;
const isPreview = Astro.url.searchParams.get('preview') === 'true';

// Set public caching header per PRD section 8
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=60, stale-while-revalidate=300'
);

let page: any = null;
let navPages: Array<{ title: string; slug: string }> = [];
let relatedProjects: any[] = [];
let relatedJobs: any[] = [];

try {
  let supabase = getPublicSupabase();
  if (isPreview) {
    // Use server client if preview requested to allow draft reading
    supabase = createSupabaseServerClient(Astro);
  }

  // 1. Fetch current page
  let query = supabase.from('pages').select('*').eq('slug', slug);
  if (!isPreview) {
    query = query.eq('status', 'published');
  }
  const { data: pageData } = await query.maybeSingle();
  page = pageData;

  // 2. Fetch published pages for dynamic navbar
  const { data: navData } = await getPublicSupabase()
    .from('pages')
    .select('title, slug')
    .eq('status', 'published')
    .eq('show_in_nav', true)
    .order('nav_order', { ascending: true });

  if (navData) {
    navPages = navData;
  }

  // 3. Pre-fetch projects/jobs if page has project_grid or job_timeline blocks
  const hasProjectGrid = page?.blocks?.some((b: any) => b.type === 'project_grid');
  const hasJobTimeline = page?.blocks?.some((b: any) => b.type === 'job_timeline');

  if (hasProjectGrid) {
    const { data: pData } = await getPublicSupabase()
      .from('projects')
      .select('*')
      .eq('status', 'published')
      .order('sort_order', { ascending: true });
    if (pData) relatedProjects = pData;
  }

  if (hasJobTimeline) {
    const { data: jData } = await getPublicSupabase()
      .from('jobs')
      .select('*')
      .eq('status', 'published')
      .order('sort_order', { ascending: true });
    if (jData) relatedJobs = jData;
  }
} catch (err) {
  console.error('Error fetching page /p/' + slug, err);
}

// 404 check if page doesn't exist
if (!page) {
  Astro.response.status = 404;
}

// Pre-render rich text markdown blocks with rehype-sanitize
const renderedBlocks = page?.blocks ? await Promise.all(
  page.blocks.map(async (block: any) => {
    if (block.type === 'rich_text') {
      const html = await renderAndSanitizeMarkdown(block.data?.content || '');
      return { ...block, sanitizedHtml: html };
    }
    return block;
  })
) : [];
---

{page ? (
  <Layout
    title={page.seo?.title || `${page.title} — Muhammad Fadhil Al Wafie (Walex)`}
    description={page.seo?.description || "Halaman editorial publik Walex."}
    image={page.seo?.og_image || undefined}
  >
    <!-- Dynamic Header / Navbar -->
    <header class="sticky top-0 z-40 bg-[#FBFBF9]/90 backdrop-blur-md border-b border-[#E7E5E4] transition-all">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="font-serif text-2xl font-bold tracking-tight text-[#1C1917] hover:text-[#EA580C] transition-colors">
          walex<span class="text-[#EA580C]">.</span>
        </a>
        
        <nav class="hidden md:flex items-center space-x-6 text-sm font-medium tracking-wide text-[#78716C]">
          <a href="/#karya" class="hover:text-[#1C1917] transition-colors">Karya</a>
          <a href="/#peran" class="hover:text-[#1C1917] transition-colors">Peran &amp; Skill</a>
          <a href="/#tentang" class="hover:text-[#1C1917] transition-colors">Tentang</a>
          <a href="/#rekam-jejak" class="hover:text-[#1C1917] transition-colors">Galeri Event</a>
          
          {navPages.map((np) => (
            <a
              href={`/p/${np.slug}`}
              class={`hover:text-[#1C1917] transition-colors ${np.slug === slug ? 'text-[#EA580C] font-bold' : ''}`}
            >
              {np.title}
            </a>
          ))}
          
          <a href="/#kontak" class="hover:text-[#1C1917] transition-colors">Kontak</a>
        </nav>

        <a href="/#kontak" class="inline-flex items-center gap-2 px-4 py-2 border border-[#1C1917] text-xs font-mono uppercase tracking-wider text-[#1C1917] hover:bg-[#1C1917] hover:text-[#FBFBF9] transition-all">
          Hubungi Saya
        </a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-16 md:py-24 space-y-16">
      
      {/* Page Title & Breadcrumb */}
      <div class="space-y-4 border-b border-[#E7E5E4] pb-8 reveal">
        <div class="flex items-center gap-2 text-xs font-mono text-[#78716C]">
          <a href="/" class="hover:text-[#EA580C]">Beranda</a>
          <span>/</span>
          <span class="text-[#1C1917] uppercase tracking-wider">Halaman</span>
        </div>
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-normal text-[#1C1917] leading-tight">
          {page.title}
        </h1>
      </div>

      {/* Render Modular Blocks */}
      <div class="space-y-16">
        {renderedBlocks.map((block: any) => (
          <section class="reveal">
            
            {/* HEADING BLOCK */}
            {block.type === 'heading' && (
              <div class={block.data.align === 'center' ? 'text-center' : 'text-left'}>
                {block.data.level === 'h1' && (
                  <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-[#1C1917]">
                    {block.data.text}
                  </h1>
                )}
                {block.data.level === 'h2' && (
                  <h2 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold text-[#1C1917]">
                    {block.data.text}
                  </h2>
                )}
                {block.data.level === 'h3' && (
                  <h3 class="font-serif text-xl sm:text-2xl font-bold text-[#1C1917]">
                    {block.data.text}
                  </h3>
                )}
              </div>
            )}

            {/* RICH TEXT (Sanitized Markdown) */}
            {block.type === 'rich_text' && (
              <div
                class="prose prose-stone max-w-none text-[#1C1917] font-sans leading-relaxed text-base md:text-lg space-y-4"
                set:html={block.sanitizedHtml}
              />
            )}

            {/* SINGLE IMAGE */}
            {block.type === 'image' && block.data.url && (
              <figure class="space-y-3">
                <div class="border border-[#E7E5E4] bg-white overflow-hidden card-img-wrap">
                  <img
                    src={block.data.url}
                    alt={block.data.alt || page.title}
                    class="w-full max-h-[600px] object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                {block.data.caption && (
                  <figcaption class="text-center font-mono text-xs text-[#78716C] italic">
                    {block.data.caption}
                  </figcaption>
                )}
              </figure>
            )}

            {/* GALLERY GRID */}
            {block.type === 'gallery' && (block.data.images || []).length > 0 && (
              <div class={`grid gap-4 ${
                block.data.columns === 2
                  ? 'grid-cols-1 sm:grid-cols-2'
                  : block.data.columns === 4
                  ? 'grid-cols-2 sm:grid-cols-4'
                  : 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3'
              }`}>
                {block.data.images.map((img: any) => (
                  <div class="border border-[#E7E5E4] bg-white overflow-hidden card-hover card-img-wrap">
                    <img
                      src={img.url}
                      alt={img.alt || 'Galeri Foto'}
                      class="w-full aspect-video object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            )}

            {/* PROJECT GRID */}
            {block.type === 'project_grid' && (
              <div class="space-y-6">
                {block.data.title && (
                  <h3 class="font-serif text-2xl font-bold text-[#1C1917]">{block.data.title}</h3>
                )}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {relatedProjects.map((p) => (
                    <div class="border border-[#E7E5E4] p-6 bg-white space-y-3 card-hover">
                      <span class="text-[10px] font-mono uppercase px-2 py-0.5 bg-[#EA580C]/10 text-[#EA580C] font-semibold">
                        {p.category || 'Project'}
                      </span>
                      <h4 class="font-serif text-xl font-bold text-[#1C1917]">{p.title}</h4>
                      <p class="text-xs text-[#78716C] leading-relaxed line-clamp-2">{p.description}</p>
                      {p.links?.url && (
                        <a
                          href={p.links.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-block text-xs font-mono text-[#EA580C] hover:underline pt-2"
                        >
                          Buka Aplikasi Live ↗
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* JOB TIMELINE */}
            {block.type === 'job_timeline' && (
              <div class="space-y-6">
                {block.data.title && (
                  <h3 class="font-serif text-2xl font-bold text-[#1C1917]">{block.data.title}</h3>
                )}
                <div class="space-y-4 border-l-2 border-[#EA580C] pl-6 ml-2">
                  {relatedJobs.map((j) => (
                    <div class="space-y-1 relative">
                      <span class="absolute -left-[31px] top-1.5 w-3 h-3 bg-[#EA580C] rounded-full border-2 border-white"></span>
                      <span class="text-xs font-mono text-[#78716C]">
                        {j.is_current ? 'Saat Ini' : `${j.start_date || ''} - ${j.end_date || ''}`} • {j.location}
                      </span>
                      <h4 class="font-serif text-lg font-bold text-[#1C1917]">{j.role}</h4>
                      <p class="text-xs font-mono text-[#EA580C]">{j.org}</p>
                      {j.description && <p class="text-xs text-[#78716C] pt-1">{j.description}</p>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* VIDEO EMBED */}
            {block.type === 'video_embed' && block.data.url && (
              <figure class="space-y-2">
                <div class="aspect-video w-full border border-[#E7E5E4] bg-black overflow-hidden shadow-sm">
                  <iframe
                    src={getVideoEmbedUrl(block.data.url) || ''}
                    class="w-full h-full"
                    title="Video Player"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
                {block.data.caption && (
                  <figcaption class="text-center font-mono text-xs text-[#78716C] italic">
                    {block.data.caption}
                  </figcaption>
                )}
              </figure>
            )}

            {/* CALL TO ACTION (CTA) */}
            {block.type === 'cta' && (
              <div class="bg-[#1C1917] text-[#FBFBF9] p-8 sm:p-12 text-center space-y-5 border border-[#1C1917]">
                <h3 class="font-serif text-2xl sm:text-3xl md:text-4xl font-normal text-white">
                  {block.data.title || 'Mari Berkolaborasi.'}
                </h3>
                {block.data.subtitle && (
                  <p class="text-gray-400 text-sm max-w-lg mx-auto font-sans leading-relaxed">
                    {block.data.subtitle}
                  </p>
                )}
                {block.data.button_text && (
                  <a
                    href={block.data.button_url || '/#kontak'}
                    class="inline-block px-8 py-3.5 bg-[#EA580C] text-white font-mono text-xs uppercase tracking-widest font-bold hover:bg-white hover:text-[#1C1917] transition-all btn-micro"
                  >
                    {block.data.button_text}
                  </a>
                )}
              </div>
            )}

            {/* DIVIDER */}
            {block.type === 'divider' && (
              <div>
                {block.data.style === 'dots' ? (
                  <div class="text-center text-[#EA580C] tracking-widest text-lg">
                    • &nbsp; • &nbsp; •
                  </div>
                ) : block.data.style === 'spacing' ? (
                  <div class="h-12"></div>
                ) : (
                  <hr class="border-t border-[#E7E5E4]" />
                )}
              </div>
            )}

          </section>
        ))}
      </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-[#E7E5E4] py-8 bg-[#FBFBF9] text-xs font-mono text-[#78716C]">
      <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div>
          © 2026 <strong class="text-[#1C1917]">Muhammad Fadhil Al Wafie (Walex)</strong>. Hak Cipta Dilindungi.
        </div>
        <div>
          <a href="#" class="hover:text-[#EA580C]">Kembali ke Atas ↑</a>
        </div>
      </div>
    </footer>
  </Layout>
) : (
  <Layout title="Halaman Tidak Ditemukan (404) — Walex Portfolio">
    <div class="min-h-[70vh] flex flex-col items-center justify-center p-6 text-center font-mono space-y-4">
      <span class="text-4xl text-[#EA580C]">404</span>
      <h1 class="font-serif text-3xl md:text-4xl text-[#1C1917]">Halaman Tidak Ditemukan</h1>
      <p class="text-xs text-[#78716C] max-w-md">
        Halaman yang Anda cari mungkin sedang dalam status draf, telah dipindahkan, atau tautannya tidak valid.
      </p>
      <a
        href="/"
        class="inline-block px-5 py-2.5 bg-[#1C1917] text-white text-xs uppercase tracking-wider hover:bg-[#EA580C] transition-colors mt-4"
      >
        ← Kembali ke Beranda
      </a>
    </div>
  </Layout>
)}
