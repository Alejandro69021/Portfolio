            <div><span class="text-[#EA580C]">↳</span> Terbah, Pengasih, Kulon Progo, DIY</div>
            <div><span class="text-[#EA580C]">→</span> WA: <a href="https://wa.me/6285717225399" class="text-[#EA580C] hover:underline">+62 857-1722-5399</a></div>
            <div><span class="text-[#EA580C]">→</span> Email: fadhilalwafie@gmail.com</div>
            <div><span class="text-[#EA580C]">→</span> IG: <a href="https://www.instagram.com/wafiens_" target="_blank" class="text-[#EA580C] hover:underline">@wafiens_</a></div>
          </div>
        </div>

        <div class="lg:col-span-7" data-reveal="slide-right" data-stagger="100">
          <form 
            id="contact-form"
            name="contact" 
            method="POST" 
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            class="space-y-6 font-mono text-xs"
          >
            <input type="hidden" name="form-name" value="contact" />
            <!-- Honeypot anti-spam (hidden from humans) -->
            <p class="hidden" aria-hidden="true">
              <label>Don't fill this out: <input name="bot-field" /></label>
            </p>

            <div class="form-field" data-reveal="fade-up">
              <input 
                type="text" 
                id="name" 
                name="name" 
                required 
                placeholder=" "
                autocomplete="name"
                class="w-full bg-gray-900 border border-gray-800 p-3 text-white focus:border-[#EA580C] focus:outline-none transition-colors"
              />
              <label for="name">Nama Lengkap *</label>
            </div>

            <div class="form-field" data-reveal="fade-up">
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder=" "
                autocomplete="email"
                class="w-full bg-gray-900 border border-gray-800 p-3 text-white focus:border-[#EA580C] focus:outline-none transition-colors"
              />
              <label for="email">Alamat Email *</label>
            </div>

            <div class="space-y-2" data-reveal="fade-up">
              <label for="subject" class="block uppercase tracking-wider text-gray-300">Subjek Proyek / Peran *</label>
              <select 
                id="subject" 
                name="subject" 
                class="w-full bg-gray-900 border border-gray-800 p-3 text-white focus:border-[#EA580C] focus:outline-none transition-colors"
              >
                <option value="Health Promotion">Konsultasi Promosi Kesehatan / K3</option>
                <option value="Health-Tech">Implementasi SISE v2.4 / Health-Tech</option>
                <option value="Video Photography">Dokumentasi Event / Foto / Video</option>
                <option value="Peer Counseling">Konseling Sebaya / Lainnya</option>
              </select>
            </div>

            <div class="form-field form-field-textarea" data-reveal="fade-up">
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder=" "
                class="w-full bg-gray-900 border border-gray-800 p-3 text-white focus:border-[#EA580C] focus:outline-none transition-colors"
              ></textarea>
              <label for="message">Pesan *</label>
            </div>

            <div data-reveal="fade-up">
              <button 
                type="submit" 
                class="w-full py-4 bg-[#EA580C] text-white uppercase tracking-widest font-bold hover:bg-white hover:text-[#1C1917] transition-all btn-submit btn-micro"
              >
                <span class="btn-submit-text">Kirim Pesan</span>
                <span class="btn-submit-loading hidden inline-flex items-center justify-center">
                  <svg class="animate-spin w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                  Mengirim...
                </span>
              </button>
            </div>

            <!-- Success / Error feedback -->
            <div id="form-feedback" class="hidden" role="status" aria-live="polite"></div>
          </form>
        </div>

      </div>
    </section>

