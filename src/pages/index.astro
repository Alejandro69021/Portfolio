        <div class="font-serif text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#1C1917] lowercase">galeri.</div>
        <span class="text-xs font-mono uppercase tracking-widest text-[#EA580C] block">Rekam Jejak Event</span>
        <h2 class="font-serif text-3xl md:text-4xl font-normal text-[#1C1917]">Galeri Liputan &amp; Dokumentasi</h2>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-2 border-b border-[#E7E5E4] pb-4" role="group" aria-label="Filter kategori galeri" data-reveal="fade-up" data-delay="80">
        <button class="filter-btn active px-4 py-2 border border-[#1C1917] bg-[#1C1917] text-white text-xs font-mono uppercase transition-all" data-filter="all" aria-pressed="true">
          Semua Event
        </button>
        {eventCategories.map((cat) => (
          <button class="filter-btn px-4 py-2 border border-[#E7E5E4] bg-[#FBFBF9] text-[#1C1917] hover:border-[#1C1917] text-xs font-mono uppercase transition-all" data-filter={cat} aria-pressed="false">
            {cat}
          </button>
        ))}
      </div>

      <!-- Gallery Grid -->
      <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 relative" data-stagger="60">
        {galleryEvents.map((ev) => (
          <div 
            class="gallery-item group bg-[#E7E5E4]/20 border border-[#E7E5E4] p-6 space-y-4 cursor-pointer hover:border-[#EA580C] card-hover"
            data-reveal="fade-up"
            data-category={ev.cat}
            data-title={ev.title}
            data-roles={ev.roles}
            data-gear={ev.gear}
            data-desc={ev.desc}
            tabindex="0"
            role="button"
            aria-label={`Buka detail ${ev.title}`}
          >
            <div class="flex justify-between items-start">
              <span class="text-[10px] font-mono uppercase bg-[#EA580C]/10 text-[#EA580C] px-2 py-0.5">{ev.cat}</span>
              <span class="card-arrow text-xs font-mono text-[#78716C]">↗</span>
            </div>

            <h4 class="font-serif font-bold text-lg text-[#1C1917] group-hover:text-[#EA580C] transition-colors">
              {ev.title}
            </h4>

            <p class="text-xs text-[#78716C] line-clamp-2">{ev.desc}</p>

            <div class="pt-2 border-t border-[#E7E5E4] text-[11px] font-mono text-[#1C1917]">
              <span>Peran: {ev.roles}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CONTACT SECTION (Netlify Form Ready) -->
