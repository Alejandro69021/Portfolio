              <span class="text-[#EA580C] uppercase tracking-wider font-semibold">Kamera Utama:</span>
              <ul class="mt-1 space-y-1 text-gray-300">
                {gearList.cameras.map(c => <li><span class="text-[#EA580C]">—</span> {c}</li>)}
              </ul>
            </div>

            <div data-reveal="fade-up">
              <span class="text-[#EA580C] uppercase tracking-wider font-semibold">Lensa &amp; Aksesori:</span>
              <ul class="mt-1 space-y-1 text-gray-300">
                {gearList.lenses.map(l => <li><span class="text-[#EA580C]">—</span> {l}</li>)}
