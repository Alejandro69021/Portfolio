const defaultGearList = {
  cameras: ["Sony A6400", "Fujifilm XA-3"],
  lenses: ["Aspherical Super EBC Lens 55-200mm"],
  accessories: ["Tripod Zomei"],
  mobile: ["Oppo Reno 8", "Xiaomi Redmi Note 13 Pro", "Xiaomi Redmi 7"]
};

const defaultRandomFacts = [
  { label: "Lokasi Basisfungsi", val: "Terbah, Pengasih, Kulon Progo, DI Yogyakarta" },
  { label: "Hobi & Passion", val: "Enthusiast Trail Run Race (Dieng Caldera, Telomoyo)" },
  { label: "Konseling Peer", val: "Konselor Sebaya Kesehatan Mental Aktif di UNY" },
  { label: "Pendidikan", val: "D4 Promosi Kesehatan - Universitas Negeri Yogyakarta (2023-Sekarang)" }
];

// ── Fetch from Supabase (Only published status, with seamless fallback) ───────
let profile = defaultProfile;
let roles = defaultRoles;
let skillChart = defaultSkillChart;
let featuredProjects = defaultFeaturedProjects;
let photoStrip = defaultPhotoStrip;
let galleryEvents = defaultGalleryEvents;
let gearList = defaultGearList;
let randomFacts = defaultRandomFacts;
let eventCategories: string[] = ['Olahraga / Race', 'Kampus UNY', 'Medis'];

try {
  const supabase = getPublicSupabase();

  const [settingsRes, projectsRes, eventsRes, categoriesRes] = await Promise.all([
    supabase.from('site_settings').select('data').eq('id', 1).maybeSingle(),
    supabase.from('projects').select('*').eq('status', 'published').order('sort_order', { ascending: true }),
    supabase.from('events').select('*, event_categories(name)').eq('status', 'published').order('sort_order', { ascending: true }),
    supabase.from('event_categories').select('name').order('sort_order', { ascending: true })
  ]);

  // Site Settings
  if (settingsRes?.data?.data) {
    const d = settingsRes.data.data;
    if (d.profile) profile = d.profile;
    if (d.roles) roles = d.roles;
    if (d.skillChart) skillChart = d.skillChart;
    if (d.gearList) gearList = d.gearList;
    if (d.randomFacts) randomFacts = d.randomFacts;
    if (d.photoStrip) photoStrip = d.photoStrip;
  }

  // Projects (Karya)
  if (projectsRes?.data && projectsRes.data.length > 0) {
    featuredProjects = projectsRes.data.map(p => {
      const isSim = Boolean(p.links?.interactiveSimulator || p.slug === 'sise-v2-4');
      const isHyprevent = p.slug.includes('hyprevent');
      const isCeritaku = p.slug.includes('ceritaku');
      const id = isSim ? 'sise' : (isHyprevent ? 'hyprevent' : (isCeritaku ? 'ceritaku' : p.slug));

      return {
        id,
        name: p.title,
        title: p.subtitle || '',
        client: p.links?.client || '',
        tags: p.stack || [],
        badge: p.links?.badge || p.category || 'Project',
        description: p.description || '',
        features: p.features || [],
        url: p.links?.url,
        interactiveSimulator: isSim
      };
    });
  }

  // Events (Galeri)
  if (eventsRes?.data && eventsRes.data.length > 0) {
    galleryEvents = eventsRes.data.map(e => ({
      title: e.title,
      roles: e.role || '',
      cat: (e.event_categories as any)?.name || 'Semua Event',
      gear: e.camera || '',
      desc: e.description || ''
    }));
  }

  // Event Categories
  if (categoriesRes?.data && categoriesRes.data.length > 0) {
    eventCategories = categoriesRes.data
      .map(c => c.name)
      .filter((name: string) => name && name !== 'Semua Event');
  }
} catch (err) {
  // If Supabase is unreachable, fallback values will be used cleanly.
  console.warn('Supabase fetch failed or not configured, using fallback data:', err);
}
